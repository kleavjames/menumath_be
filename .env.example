# Copy to `.env` and adjust. For local Docker Postgres, prefer copying
# `.env.local.example` to `.env.local` (overrides `.env` when present).

# --- Local Docker Postgres (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=menumath-be
POSTGRES_PORT=5432

# App + Prisma runtime (local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menumath-be

# --- Production (Neon) — set on your host (Railway, Render, Mau, etc.), not committed ---
# DATABASE_URL=postgresql://...@...-pooler....neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://...@....neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-in-production
PORT=3000
