// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  CAFE
  RESTAURANT
  BAKERY
  FOOD_TRUCK
  CATERING
  BAR
}

enum Currency {
  USD
  PHP
  EUR
  GBP
  CAD
  AUD
  NZD
  JPY
  SGD
  INR
  MXN
}

enum UnitSystem {
  METRIC
  IMPERIAL
  BOTH
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
}

enum CategoryType {
  INGREDIENT
  RECIPE
}

enum Unit {
  KG
  G
  ML
  L
  TSP
  TBSP
  EACH
  DOZEN
  OZ
  LB
  FL_OZ
  CUP
  GAL
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships            BusinessMember[]
  createdInvitationCodes InvitationCode[] @relation("InvitationCodeCreatedBy")
}

model Business {
  id             String       @id @default(cuid())
  name           String
  type           BusinessType
  currency       Currency
  targetFoodCost Decimal      @db.Decimal(5, 2)
  unitSystem     UnitSystem   @default(METRIC)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members         BusinessMember[]
  invitationCodes InvitationCode[]
  categories      Category[]
  ingredients     Ingredient[]
  recipes         Recipe[]
}

model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  role       MemberRole
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
}

model InvitationCode {
  id              String     @id @default(cuid())
  code            String     @unique
  businessId      String
  role            MemberRole
  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime   @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User     @relation("InvitationCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([businessId])
}

model Category {
  id         String       @id @default(cuid())
  name       String
  type       CategoryType
  businessId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  recipes     Recipe[]

  @@unique([businessId, type, name])
  @@index([businessId, type])
}

model Ingredient {
  id                String   @id @default(cuid())
  businessId        String
  categoryId        String
  name              String
  supplier          String
  itemSize          Decimal  @db.Decimal(12, 4)
  itemSizeUnit      Unit
  itemPrice         Decimal  @db.Decimal(12, 4)
  usableCostPerItem Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipes  RecipeIngredient[]

  @@index([businessId])
  @@index([categoryId])
}

model Recipe {
  id              String   @id @default(cuid())
  businessId      String
  categoryId      String
  name            String
  servings        Int
  pricePerServing Decimal  @db.Decimal(12, 4)
  costPerServing  Decimal  @db.Decimal(12, 4)
  recipeCost      Decimal  @db.Decimal(12, 4)
  profit          Decimal  @db.Decimal(12, 4)
  margin          Decimal  @db.Decimal(7, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients RecipeIngredient[]

  @@index([businessId])
  @@index([categoryId])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 4)
  unit         Unit

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}
